Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Ground
      Enabled: true
      Color Transformer: FlatColor
      Color: 70; 200; 100
      Position Transformer: XYZ
      Size (m): 0.04
      Style: Points
      Topic:
        Value: /ground_cloud
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Non-ground
      Enabled: true
      Color Transformer: FlatColor
      Color: 240; 100; 70
      Position Transformer: XYZ
      Size (m): 0.04
      Style: Points
      Topic:
        Value: /no_ground_cloud
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Odometry
      Name: Paired odometry
      Enabled: true
      Keep: 1
      Topic:
        Value: /ground_seg/odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.7
      Yaw: 0.7
Window Geometry:
  Width: 1280
  Height: 800
