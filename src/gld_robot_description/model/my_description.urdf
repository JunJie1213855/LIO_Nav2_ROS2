<?xml version="1.0"?>
<robot name="gld_robot_description">

  <!--
    base_footprint = IMU 本体 = 机器人机身参照系
    (因为 IMU 固连在机身上, 直接以 IMU 作为坐标系原点, 不再需要 chassis 中间层)
  -->
  <link name="base_footprint" />

  <!-- LiDAR 传感器 -->
  <link name="livox_frame" />

  <!--
    LiDAR 相对 IMU 的外参:

    extrinsic_T: [0.0, 0.0, 0.0]    ← 同位 (LiDAR 和 IMU 安装在同一位置)

    extrinsic_R: [ 0, -1,  0 ]      ← LiDAR X = -IMU Y
                 [-1,  0,  0 ]      ← LiDAR Y = -IMU X
                 [ 0,  0, -1 ]      ← LiDAR Z = -IMU Z

    转为 RPY (X-Y-Z 固定角):
      roll  = atan2(-1,  0) =  π     (≈ 3.1416 rad, Z 轴翻转 180°)
      pitch = -asin(0)       =  0
      yaw   = atan2( 0, -1) = -π/2  (≈ -1.5708 rad, X/Y 交换 -90°)
  -->
  <joint name="imu_to_livox" type="fixed">
    <parent link="base_footprint"/>
    <child link="livox_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="3.1416 0.0 -1.5708"/>
  </joint>

</robot>
